# 阿里云百炼（DashScope）API Key —— 必填，LLM 与向量化共用
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# LLM 模型（qwen-plus / qwen-max / qwen-turbo）
LLM_MODEL=qwen-plus

# 向量化模型
EMBEDDING_MODEL=text-embedding-v3

# 重排序模型（可选开关 RERANK_ENABLED）
RERANK_MODEL=gte-rerank-v2

# JWT 密钥（生产环境务必修改）
SECRET_KEY=9f2c7b1e4a8d6f3c5e2b9a7d1f4c8e6b0a3d5f7c9e1b4a6d8f0c2e5b7a9d1f3a5c7e9b

# CORS 允许的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
